fn swap(arr: int[], a: int, b: int) {
    let tmp: int = arr[a];
    arr[a] = arr[b];
    arr[b] = tmp;
}

fn partition(arr: int[], lo: int, hi: int) -> int {
    let mid: int = lo + (hi - lo) / 2;
    if arr[lo] > arr[mid] { swap(arr, lo, mid); }
    if arr[lo] > arr[hi] { swap(arr, lo, hi); }
    if arr[mid] > arr[hi] { swap(arr, mid, hi); }
    swap(arr, mid, hi);
    let pivot: int = arr[hi];
    let mut i: int = lo - 1;
    let mut j: int = lo;
    while j < hi {
        if arr[j] <= pivot {
            i = i + 1;
            let tmp: int = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
        }
        j = j + 1;
    }
    let tmp: int = arr[i + 1];
    arr[i + 1] = arr[hi];
    arr[hi] = tmp;
    i + 1
}

fn quicksort(arr: int[], lo: int, hi: int) {
    if lo < hi {
        let p: int = partition(arr, lo, hi);
        quicksort(arr, lo, p - 1);
        quicksort(arr, p + 1, hi);
    }
}

fn main() {
    let mut arr: int[] = [];
    let mut i: int = 100000;
    while i >= 1 {
        arr.push(i);
        i = i - 1;
    }
    quicksort(arr, 0, 99999);
    let first: int = arr[0];
    let last: int = arr[99999];
    log::info($"{first} {last}");
}

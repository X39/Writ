fn main() {
    let n: int = 1000000;
    let mut sieve: int[] = [];
    let mut i: int = 0;
    while i <= n {
        sieve.push(1);
        i = i + 1;
    }
    sieve[0] = 0;
    sieve[1] = 0;
    i = 2;
    while i * i <= n {
        if sieve[i] == 1 {
            let mut j: int = i * i;
            while j <= n {
                sieve[j] = 0;
                j = j + i;
            }
        }
        i = i + 1;
    }
    let mut count: int = 0;
    let mut k: int = 0;
    while k <= n {
        count = count + sieve[k];
        k = k + 1;
    }
    log::info($"{count}");
}
